    "app/api/cron/nyt/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/google-trends/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/twitter/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/tiktok/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/compute-trends/route.ts": {
      "maxDuration": 300
    }
  }
