{
  "name": "trenderai-ingest",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --esm src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "db:migrate": "ts-node --esm src/tools/run-migration.ts",
    "run:youtube": "ts-node --esm src/connectors/run-youtube.ts",
    "run:gdelt": "ts-node --esm src/connectors/run-gdelt.ts",
    "run:reddit": "ts-node --esm src/connectors/run-reddit.ts",
    "run:rss": "ts-node --esm src/connectors/run-rss.ts"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bullmq": "^5.7.4",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "rss-parser": "^3.13.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/pg": "^8.15.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
