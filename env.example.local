# Database Configuration
DATABASE_URL="postgresql://username:password@host:port/database"

# Authentication
INGEST_SECRET="your-super-secret-key-here"
CRON_SECRET="your-cron-secret-key-here"

# Feature Toggles
ENABLE_REDDIT=true
ENABLE_NYTIMES=false
ENABLE_YOUTUBE=false

# API Keys (optional - only needed if corresponding feature is enabled)
NYTIMES_API_KEY=""
YOUTUBE_API_KEY=""

# Reddit Configuration (no API key required)
REDDIT_SUBREDDITS="all,popular,trending"
REDDIT_LIMIT=25

# NYTimes Configuration
NYTIMES_SECTION="mostpopular"

# YouTube Configuration
YOUTUBE_REGION_CODE="US"
YOUTUBE_VIDEO_CATEGORY_ID="0"

# Logging
LOG_LEVEL="info"
NODE_ENV="development"

# Performance
DB_POOL_SIZE=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000

# Rate Limiting
REDDIT_RATE_LIMIT_MS=1000
NYTIMES_RATE_LIMIT_MS=1000
YOUTUBE_RATE_LIMIT_MS=1000

# Materialized View Refresh
MV_REFRESH_INTERVAL_MINUTES=15
