SYMBOLS=AAPL,MSFT,NVDA,TSLA,BTC,ETH

# local/dev cron
ENABLE_LOCAL_CRON=false

# Hardening features
SENTRY_DSN=
SENTRY_ENV=production
USE_SEARCH_MV=true
LOG_LEVEL=info

# Google Trends (choose one provider below)
SERPAPI_API_KEY=3b15224c89b91cf3ef850fd7bc0c0453f9273a1049b382479462adc067c086ba
TRENDS_DEFAULT_GEO=US
TRENDS_DEFAULT_TZ=420   # minutes offset from UTC (PDT=420)

# When granted access to Google's official Trends API (alpha)
TRENDS_ALPHA_ENABLED=false
TRENDS_ALPHA_BASE_URL=
TRENDS_ALPHA_TOKEN=

# Instagram Graph API (Business/Creator account required)
IG_APP_ID=1820527612174665
IG_APP_SECRET=152400dbc36d10b091d9da58ff0591c4
IG_USER_ID=6944483808            # Numeric IG Business/Creator user id (not @username)
IG_LONG_LIVED_TOKEN=   # Long-lived access token (60 days)
IG_DEFAULT_HASHTAGS=ai,tech,startups,bitcoin

# Caching / defaults
IG_CACHE_TTL_SECONDS=900
IG_DEFAULT_GEO=GLOBAL

# Open Graph fetcher (for better thumbnails)
OG_CACHE_TTL_SECONDS=86400     # 1 day
OG_TIMEOUT_MS=7000             # 7s request timeout
OG_MAX_HTML_BYTES=900000       # ~0.9MB max read per page

# X (Twitter) API
X_BEARER_TOKEN=          # Required: OAuth 2.0 App-only Bearer
X_DEFAULT_QUERIES=ai agents,bitcoin,gpu,startups
X_TRENDS_WOEIDS=23424977 # US WOEID; comma-separate for multiples
X_CACHE_TTL_SECONDS=600  # 10 minutes cache

# X Filtered Stream (NEW)
X_STREAM_ENABLED=true
# Comma or newline separated rules. Examples:
#  - "ai (has:images OR has:videos) -is:reply lang:en"
#  - "(gpu OR nvidia) (has:images OR has:videos) -is:reply lang:en"
X_STREAM_RULES=ai (has:images OR has:videos) -is:reply lang:en
X_STREAM_AUTO_START=true
X_STREAM_BACKOFF_MAX_SEC=60

# TikTok Ingestion System
TIKTOK_APIFY_TOKEN=your-apify-token
TIKTOK_APIFY_ACTOR_ID=apify/actor-tiktok-scraper
TIKTOK_APIFY_USER_ID=your-apify-user-id

# TikTok Data Sources (comma-separated)
# Format: trending,hashtag:ai,hashtag:tech,user:nike,user:apple
TIKTOK_SOURCES=trending,hashtag:ai,hashtag:tech

# TikTok Ingestion Configuration
TIKTOK_INGEST_ENABLED=true
TIKTOK_INGEST_CRON=*/15 * * * *  # Every 15 minutes
TIKTOK_MAX_POSTS_PER_SOURCE=50
TIKTOK_MIN_POST_AGE_HOURS=1      # Only fetch posts from last hour
TIKTOK_MAX_POST_AGE_HOURS=24     # Don't fetch posts older than 24 hours
TIKTOK_RATE_LIMIT_DELAY_MS=1000  # Delay between API calls
TIKTOK_MAX_RETRIES=3
TIKTOK_RETRY_DELAY_MS=5000

# TikTok Data Processing
TIKTOK_ENABLE_HOURLY_AGGREGATION=true
TIKTOK_AGGREGATION_CRON=0 * * * *  # Every hour
TIKTOK_CLEANUP_OLD_DATA_DAYS=30    # Keep data for 30 days
TIKTOK_ENABLE_DEAD_LETTER_QUEUE=true

# TikTok API Configuration
TIKTOK_API_TIMEOUT_MS=30000
TIKTOK_API_MAX_CONCURRENT_REQUESTS=3
TIKTOK_ENABLE_RAW_DATA_STORAGE=true
TIKTOK_ENABLE_DEBUG_LOGGING=false

# YouTube API Configuration
YOUTUBE_API_KEY=your-youtube-api-key
YOUTUBE_REGION_CODE=US
YOUTUBE_VIDEO_CATEGORY_ID=0
YOUTUBE_RATE_LIMIT_MS=1000
ENABLE_YOUTUBE=true

# NYTimes API
NYT_API_KEY=your-nyt-api-key
NYT_TOP_SECTIONS=home,technology,business,world,science,us
NYT_MOSTPOPULAR_PERIODS=1,7
NYT_TIMESWIRE_HOURS=24

# Scheduler
INGEST_CRON=*/15 * * * *

# Semantic / TimesTags
NYT_SEMANTIC_MAX_RESULTS=10
NYT_SEMANTIC_SAMPLE_WINDOW_HOURS=24  # enrich items published in this window

# TTI Tracking Configuration
TTI_ENABLED=true
TTI_SAMPLE_RATE=0.1
TTI_MAX_TRACE_AGE_HOURS=24
TTI_ANONYMIZE_IPS=true
TTI_STORAGE_TTL_DAYS=30
TTI_DEBUG_MODE=false
TTI_CORRELATION_ENABLED=true
TTI_METRICS_ENDPOINT=/api/tti/metrics
TTI_STATS_ENDPOINT=/api/tti/stats
