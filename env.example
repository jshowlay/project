# Google Trends (choose one provider below)
SERPAPI_API_KEY=3b15224c89b91cf3ef850fd7bc0c0453f9273a1049b382479462adc067c086ba
TRENDS_DEFAULT_GEO=US
TRENDS_DEFAULT_TZ=420   # minutes offset from UTC (PDT=420)

# When granted access to Google's official Trends API (alpha)
