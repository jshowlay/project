# Trender AI Environment Configuration
# Copy this file to .env and fill in your actual API keys

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Reddit API (Optional - for Reddit connector)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# YouTube API (Feature Flagged - Enable only with proper credentials)
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_ENABLED=false

# News API (Optional - for news trend analysis)
NEWS_API_KEY=your_news_api_key

# Twitter/X API (Disabled - DO NOT ENABLE without proper review)
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret
TWITTER_ENABLED=false

# OpenAI API (Optional - for enhanced content generation)
OPENAI_API_KEY=your_openai_api_key

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000

# Development Settings
NODE_ENV=development
PYTHON_ENV=development

# Rate Limiting
ENABLE_RATE_LIMITING=true
REQUESTS_PER_MINUTE=60

# Features Flags
GOOGLE_TRENDS_ENABLED=true
REDDIT_ENABLED=false
YOUTUBE_ENABLED=false
NEWS_ENABLED=false
TWITTER_ENABLED=false

# Database
DATABASE_URL=your_database_connection_string

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
SECRET_KEY=your_secret_key_here
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Performance
WORKERS=1
MAX_CONNECTIONS=100
KEEPALIVE_TIMEOUT=5